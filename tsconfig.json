{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "android", "dist"]
}
